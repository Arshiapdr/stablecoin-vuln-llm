# Copy to .env and fill in ONE key to start. All of these are free tiers.
#
# Primary  - Google AI Studio (1M context, no credit card)
#            https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Fallback - Mistral La Plateforme (1B tokens/month, phone verification)
#            https://console.mistral.ai
MISTRAL_API_KEY=

# Third    - NVIDIA build.nvidia.com (~40 rpm, no token cap)
#            https://build.nvidia.com
NVIDIA_API_KEY=

# Optional - OpenRouter free models (50 requests/day with no payment)
#            https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Optional - Groq. NOTE: free tier is capped at 8k tokens/minute (Aug 2026),
#            so it only works for small slices.
#            https://console.groq.com
GROQ_API_KEY=

# Optional - Etherscan v2 unified key, only needed for on-chain mint/burn logs
#            https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# Local llama.cpp needs no key:
#   llama-server -m model.gguf -c 32768 --host 127.0.0.1 --port 8080
